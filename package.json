{
  "name": "veraz",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "replay": "bun run --cwd apps/api replay",
    "test": "bun test",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/mobile typecheck"
  }
}
