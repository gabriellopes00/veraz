{
  "name": "veraz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @veraz/api dev",
    "dev:mobile": "pnpm --filter @veraz/mobile start",
    "replay": "pnpm --filter @veraz/api replay",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2"
  }
}
