# --- API (apps/api) ---
OPENAI_API_KEY=sk-...
PORT=3000

# Optional model overrides (defaults live in apps/api/src/config.ts)
# MODEL_TRANSCRIBE=gpt-live-transcribe
# VAD_SPEECH_DB=-45
# VAD_MAX_TURN_MS=12000
# MODEL_EXTRACT=gpt-5.6-luna
# MODEL_VERIFY=gpt-5.6-luna
# VERIFY_EFFORT=low
# VERIFY_CONCURRENCY=4
# VERIFY_TIMEOUT_MS=45000

# --- Mobile (apps/mobile) ---
# Your computer's LAN IP, e.g. http://192.168.0.10:3000
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
# pcm-stream (dev build, fastest) | chunked (works in Expo Go)
EXPO_PUBLIC_AUDIO_MODE=pcm-stream
